{
  "name": "dsh-camel-pool",
  "displayName": "驼峰积分池 (Camel Pool)",
  "description": "独立的驼峰积分池插件：从渠道中心整包独立出来，自带积分池剩余额度显示面板、自动签到、按额度智能路由（402/429 自动切换），并可持续注册更多渠道以扩充模型选择。",
  "version": "1.0.15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daybyday66/dsh-camel-pool.git"
  },
  "homepage": "https://github.com/daybyday66/dsh-camel-pool#readme",
  "author": {
    "name": "daybyday66",
    "email": "172792287+daybyday66@users.noreply.github.com",
    "url": "https://github.com/daybyday66"
  },
  "keywords": [
    "dsh-plugin",
    "the coding assistant",
    "pool",
    "camel",
    "积分池",
    "credits-pool",
    "auto-checkin",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "check": "node scripts/check-all.mjs && node scripts/check-imports.mjs && node scripts/check-pool-core.mjs && node scripts/check-hardening.mjs && node scripts/check-qoder-vault.mjs && node scripts/check-checkin-device.mjs && node scripts/check-checkin-claim.mjs && node scripts/check-index-fresh.mjs",
    "check:syntax": "node scripts/check-all.mjs",
    "check:imports": "node scripts/check-imports.mjs && node scripts/check-imports.mjs --selftest",
    "check:core": "node scripts/check-pool-core.mjs",
    "check:vault": "node scripts/check-qoder-vault.mjs",
    "verify": "node scripts/verify-uxv10.mjs",
    "verify:e2e": "node scripts/verify-uxv11-e2e.mjs",
    "verify:gate": "node scripts/verify-uxv19-gate.mjs",
    "verify:net": "node scripts/verify-uxv12-escape.mjs",
    "verify:live": "node scripts/verify-uxv14-live.mjs",
    "sync": "node scripts/gh-push.mjs",
    "sync:quiet": "node scripts/gh-push.mjs --quiet"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "!scripts/reverse-verify-bugfix.mjs",
    "!scripts/sync-to-profile.mjs",
    "!scripts/probe-*.mjs",
    "!scripts/verify-gemini-*.mjs",
    "!scripts/gemini-oauth-login.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-atomic-write": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.85.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
